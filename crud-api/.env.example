# Copy this file to .env and adjust if needed. .env itself is gitignored --
# never commit real credentials, even for local dev.

POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
POSTGRES_DB=taskdb

# Host is "db" -- the service name in docker-compose.yml, not "localhost" --
# because from inside the app container, the database lives at that service name
# on the shared Docker network. Running the app OUTSIDE Docker for local dev?
# swap "db" for "localhost".
DATABASE_URL=postgresql://taskuser:taskpass@db:5432/taskdb

# memory = old A2 in-memory store (for comparison) · postgres = real persistence
REPO_TYPE=postgres
